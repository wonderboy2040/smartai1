# ============================================
# Wealth AI Pro — Environment Variables
# ============================================

# ---- V2 SIGNAL-ACCURACY UPGRADE (11 → 14 models) ----
# Enables the 3 new ensemble seats: SentimentPulse (news/F&G/funding),
# InstFlow (FII/DII + orderbook depth) and FundaCheck (P/E vs sector,
# swing path only). OFF = the exact 11-model ensemble that ships today;
# true = 14 models for the live-validation window. Data sources are all
# free + keyless (Moneycontrol/ET RSS, alternative.me F&G, Binance fapi
# funding, NSE FII/DII, Yahoo quoteSummary) — every feed degrades to an
# honest abstain when unreachable, so the flag is safe to flip on Render.
# Observe via /api/ai/status (v2Models block) + /api/ai/trust (Brier).
AI_ENABLE_V2_MODELS=false

# ---- v10.6 PRO ACCURACY UPGRADES ----
# Cross-exchange price validation (Pro #3): CoinDCX ticks are checked
# against Binance (spot /api/v3 + futures /fapi/v1 — free, keyless,
# validator-only). A fresh >0.5% (majors) / >1.5% (alts) cross-venue gap
# suppresses the signal vote / SL-TP trigger for that tick; a reverted
# wick lands in the journal as WICK_SUPPRESSED. ON by default — set to
# 1 to disable.
AI_DISABLE_WICK_FILTER=false
# Per-base deviation thresholds (%) — majors default 0.5, alts 1.5.
AI_WICK_THRESHOLD_PCT=
AI_WICK_ALT_THRESHOLD_PCT=
# Regime-aware model reweighting (Pro #4): TRENDING/CHOPPY/HIGH_VOL/
# LOW_VOL tilts the 14 model weights ±25% max (weighted-average path
# only). Default OFF — A/B it first: backtest panel strategy=
# regime_weighted, or `python -m models.backtest --strategy
# regime_weighted` in ml-service.
AI_ENABLE_REGIME_WEIGHTS=false
# Edge-adaptive Kelly-lite sizing (Pro #2): riskPerTradePct becomes the
# CEILING; the confidence bucket's realized win-rate (trust calibration,
# ≥10 settled) sizes at HALF-Kelly. Negative edge → entry skipped with
# the reason logged. Default OFF.
AI_ENABLE_KELLY_SIZING=false
# Slippage-aware execution (Pro #6): expected slippage from the L2 depth
# walk above this % (or notional beyond the visible book) → TWAP-lite
# split into 2-4 child orders with 2s gaps. Default 0.35%.
AI_SLIPPAGE_THRESHOLD_PCT=
# AI Council debate mode (v10.8 Pro #1): bull advocate → bear advocate →
# PM verdict — 3 grounded LLM steps instead of one single-shot call.
# Default ON; any step failing degrades to the legacy single-shot path.
AI_COUNCIL_DEBATE=

# ---- INTERACTIVE TELEGRAM BOT (v10.1) ----
# Makes the bot LISTEN (the /crypto, /intraday, /status commands).
# Setup (one-time after deploy):
#   1. Generate a random secret: `openssl rand -hex 24`
#   2. Set it as TELEGRAM_WEBHOOK_SECRET below (server env — Render)
#   3. Login to the site → POST /api/telegram/setup-webhook
#      { "url": "https://your-render-app.onrender.com" }
# Security: every incoming Telegram request must carry this secret in
# the X-Telegram-Bot-Api-Secret-Token header (Telegram adds it
# automatically from setWebhook) AND come from an allowlisted chat id.
TELEGRAM_WEBHOOK_SECRET=

# ---- v10.9 #6: MULTI-USER ROLES ----
# Comma-separated "chatid:role" pairs. The configured chat id (secrets
# store / TG_CHAT_ID) is ALWAYS admin. Chats listed here get access:
#   admin  — desk agents + /trade approvals (when the flow is armed)
#   viewer — read-only: desk agents, /status, /weeklyreview, voice notes
# Everyone else stays silently ignored. Example:
#   TELEGRAM_ROLES="987654321:viewer,111222333:viewer"
TELEGRAM_ROLES=

# ---- v10.9 #4: CONTROLLED TELEGRAM ORDER APPROVAL (opt-in!) ----
# Everything defaults OFF. To arm:
#   AI_TELEGRAM_APPROVALS=on
#   AI_APPROVAL_PIN=your 4-12 digit PIN   (mandatory — no PIN, no approvals)
# Flow: /trade BTC LONG 5000 x3 paper → Approve button → PIN → the
# site's EXACT executeSignal gauntlet (fresh-signal re-verification,
# kill switch, risk caps, mandate freeze). The button is a manual
# trigger — it bypasses NOTHING.
AI_TELEGRAM_APPROVALS=
AI_APPROVAL_PIN=
AI_APPROVAL_MAX_PER_DAY=3
AI_APPROVAL_TTL_MS=300000

# ---- v10.9 #2: INSTANT TELEGRAM PUSH ----
# The price-driven sink: SL/TP/LIQ level touches pushed within seconds
# (5s poll while positions are open) + fresh STRONG signals every ~30s
# (correlated clusters bundled into ONE message, r >= 0.75). The 60s
# watcher stays the executor; the legacy bot's 10-min cron becomes a
# backup heartbeat. Set off to revert to watcher-only alerts.
AI_INSTANT_PUSH=

# ---- v10.9 #3: WEEKLY TRADE-PERFORMANCE DIGEST ----
# Sunday 19:00 IST auto-push of the journal + calibration review
# (quant-computed numbers + one LLM narration). /weeklyreview runs it
# on demand regardless of this flag. Set off to disable the auto-push.
AI_WEEKLY_REVIEW_PUSH=

# SECURITY — REQUIRED (no defaults)
APP_PIN=change_me_to_a_strong_pin
VITE_ENCRYPTION_KEY=replace_with_strong_32_char_secret

# Cloud-sync auth token (Apps Script + backend proxy). Server-side name is
# API_TOKEN (used by /api/cloud/*). VITE_API_TOKEN is the browser-bundle copy
# and is ONLY needed if you use DIRECT cloud sync instead of the proxy —
# remember anything VITE_-prefixed is readable by anyone who opens the bundle.
API_TOKEN=replace_with_strong_24plus_char_secret
# VITE_API_TOKEN=replace_with_strong_24plus_char_secret

# CORS allowlist (comma-separated, for cross-origin Vercel→Render).
# SECURITY: in production (NODE_ENV=production) CORS is FAIL-CLOSED when this
# is unset — no cross-origin requests will be authorized.
ALLOWED_ORIGINS=https://your-app.vercel.app

# AI PROVIDER KEYS (server-side only)
GROQ_API_KEY=gsk_your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
CLAUDE_API_KEY=your_anthropic_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
CEREBRAS_API_KEY=your_cerebras_key_here
HF_API_KEY=your_huggingface_key_here
NVIDIA_API_KEY=your_nvidia_key_here
TAVILY_API_KEY=tvly_your_key_here

# Telegram Bot (server-side only)
TG_TOKEN=your_bot_token_here
TG_CHAT_ID=your_chat_id_here
# Shared secret for the bot's /api/* LLM relay when the bot runs standalone
# (npm run start:telegram). When set, relay calls require this Bearer token.
BOT_API_SECRET=replace_with_strong_24plus_char_secret

# Google Apps Script (Cloud Portfolio Sync) — server-side name
API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# If frontend is on a DIFFERENT origin (Vercel), set this:
# VITE_API_PROXY=https://your-backend.onrender.com

# Real-time market data
# FINNHUB_API_KEY is SHARED (v10.11): the US desk (/api/quote + the WS
# stream) AND the EQUITY SIM USDC desk's fallback chain both use it via
# server/ai/finnhubQuote.js — one micro-cache + one 55/min sliding-window
# rate limiter, so neither desk can starve the other's free-tier budget.
FINNHUB_API_KEY=your_finnhub_key_here

# ML service (optional) — required when exposing ml-service beyond localhost
# ML_API_TOKEN=replace_with_strong_24plus_char_secret
# ML_CORS_ORIGINS=https://your-app.vercel.app

# Broker connectors (optional)
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token
SHOONYA_USER_ID=your_shoonya_user_id
SHOONYA_PASSWORD=your_shoonya_password
SHOONYA_VENDOR_CODE=your_vendor_code
SHOONYA_API_KEY=your_api_key
SHOONYA_IMEI=100001

# ---- Durable runtime state (Render free plan) ----
# Render's free tier wipes server/data/ on every restart, which used to reset
# the paper-trading history to 0 AND destroy the INDMoney OAuth tokens +
# CoinDCX API keys (forcing a full re-connect after every deploy). Set these
# to mirror that state to a branch of this GitHub repo (auto-restored on
# boot). MCP credential files are pushed AES-256-GCM ENCRYPTED, so the backup
# branch never leaks keys even in a public repo:
#   GITHUB_BACKUP_TOKEN  — fine-grained PAT, Contents: Read and Write
#   GITHUB_BACKUP_REPO   — "owner/repo-name" (private repo recommended)
#   GITHUB_BACKUP_BRANCH — MUST differ from the deploy branch (default: data-backup)
#   DURABLE_KEY          — OPTIONAL dedicated encryption key (>=16 chars).
#                          If unset, the key is auto-derived from
#                          APP_PIN + API_TOKEN (already in your Render env —
#                          zero extra setup). NOTE: rotating APP_PIN or
#                          API_TOKEN makes old backups undecryptable.
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=
GITHUB_BACKUP_BRANCH=data-backup
DURABLE_KEY=

# ---- INDMoney + CoinDCX asset-table sync ----
# Auto-sync slots (IST, comma-separated HH:MM). Default: 09:30 & 21:30.
# The scheduler catches up missed slots up to 4h late (Render free-tier
# sleep). CoinDCX crypto rows ride the same schedule; the crypto price
# feed itself is always live (SSE).
INDM_SYNC_TIMES=09:30,21:30

# ---- v10.17 FULL UNIVERSE SCAN (India desk) ----
# ON by default. Tiered cadence: T1 (base watchlist + hot names) scanned
# every cycle, T2 (the ~220 most-traded NSE names discovered via the TV
# turnover filter) scanned in rotating quarter-slices — whole-market
# coverage every ~4 board cycles. Hot T2 names (|chg|>=2.5% / relVol>=2 /
# RSI 72+/28-) ride T1 cadence for 20 min. "off" reverts to the static
# ~45-name F&O base (byte-identical legacy behavior).
# AI_INDIA_FULL_UNIVERSE=off
# Discovery depth (60-500 NSE names by turnover). Default 220.
# AI_INDIA_FULL_UNIVERSE_SIZE=220

# ---- v10.17 OPTIONS SCANNER ----
# Number of stock-option underlyings (top NSE turnover F&O names) scanned
# alongside NIFTY/SENSEX/BANKNIFTY on GET /api/ai/options-scan (0-10).
# AI_OPTIONS_SCAN_STOCKS=6

# ==================== v11.1 INDIA DESK DEEP-GAPS ====================
# ---- GAP 2: CIRCUIT-LIMIT GUARD (NSE daily price bands) ----
# Groww's live quote carries the day's band (highPriceRange/lowPriceRange)
# on the SAME fetch the desk already makes. A same-direction entry near
# the adverse band (LONG->upper / SHORT->lower circuit) takes a heavy
# confidence penalty + a distinct reason flag + target clamps; open
# positions drifting toward an ADVERSE circuit fire urgent CIRCUIT_RISK
# alerts (paper watcher + India agent sweep). Bands unknown -> guard inert.
# Proximity threshold in % distance from the band (default 1.5).
# AI_CIRCUIT_PROXIMITY_PCT=1.5
# Confidence penalty for same-direction entries near the band (default 18).
# AI_CIRCUIT_PENALTY=18

# ---- GAP 3: REAL TRANSACTION COSTS on the paper desk ----
# Every closed paper trade stores grossPnl + costs + netPnl (net is the
# displayed headline; gross rides in tooltips). Rates = current published
# India schedules (Oct-2024 levels) — pin YOUR broker's numbers:
# Brokerage: 'flat' = Rs per executed ORDER (default 20, Zerodha-style;
# a T1+T2 two-part close = 3 orders) | 'percent' = % of turnover.
# AI_TC_BROKERAGE_MODE=flat
# AI_TC_BROKERAGE_FLAT=20
# AI_TC_BROKERAGE_PCT=0.03
# Statutory overrides (defaults in parentheses):
#   equity-intraday: STT 0.025% sell (0.025) · NSE txn 0.00297% both
#     (0.00297) · SEBI 0.0001% both (0.0001) · stamp 0.003% buy (0.003)
#   equity-futures:  STT 0.02% sell (0.02) · txn 0.00173% (0.00173)
#     · SEBI (0.0001) · stamp 0.002% buy (0.002)
#   options:         STT 0.1% sell premium (0.10) · txn 0.03503% premium
#     (0.03503) · SEBI (0.0001) · stamp 0.003% buy premium (0.003)
#   GST 18% on (brokerage + txn + SEBI) is fixed by law — not tunable.
# Per-instrument override keys (suffix = instrument, underscores):
# AI_TC_STT_EQUITY_INTRADAY=0.025
# AI_TC_TXN_EQUITY_INTRADAY=0.00297
# AI_TC_STT_OPTIONS=0.10
# AI_TC_TXN_OPTIONS=0.03503
# AI_TC_STT_EQUITY_FUTURES=0.02
# Crypto paper trades: approximate taker fee % per side (no STT/GST).
# AI_TC_CRYPTO_FEE_PCT=0.05

# ---- NSE + SENSEX addendum: SENSEX source honesty ----
# BSE blocks datacenter IPs structurally (spike-verified: bseindia.com +
# api.bseindia.com both 403 Akamai). SENSEX premiums are therefore ALWAYS
# Black-Scholes model estimates here (tagged 'bs-model-sensex-always',
# persistent banner, NIFTY-family keeps the recoverable
# 'bs-model-nifty-fallback' framing). Structural AI-score discount on
# SENSEX model cards — no live-market cross-check is possible (default 8).
# AI_SENSEX_MODEL_DISCOUNT=8

# ---- GAP 1: SECTOR MAP x FULL UNIVERSE ----
# Rides the same AI_INDIA_FULL_UNIVERSE switch above: the sector desk
# buckets the FULL discovered universe (curated static table first, TV's
# own sector taxonomy next, honest OTHERS for the rest) — an out-of-45
# F&O name finally surfaces through the sector lens. Flag off = the
# legacy static 45-name map, byte-identical.

# ==================== v11.0 SUPERINTELLIGENCE — GLOBAL MARKET COUNCIL ====================
# The 5-layer superintelligence pipeline: MCP Data Agent Mesh (10 agents)
# → quant feature engine → 6 specialist LLM seats → calibrated consensus +
# PRECISION GATE → stamped verdicts on both desks' signal boards.
# Everything below is OPTIONAL; the master switch defaults OFF (A/B-able
# against the v10.18 baseline — flag off = byte-identical boards).

# ---- MASTER SWITCH (default off) ----
# ON = top-5 board candidates go to the 6-seat council each cycle
# (~6 batched LLM calls / 90s, per-symbol verdict cache; suppressed
# verdicts land in the near-miss journal for the weekly review).
# AI_ENABLE_GLOBAL_COUNCIL=on

# ---- Council tuning ----
# Bull/bear debate rounds in DEEP mode (0-2; default 1). Deep mode =
# ~9 LLM calls per symbol (board mode stays 6 batched).
# AI_COUNCIL_DEBATE_ROUNDS=1
# Precision-gate publish bar: confidence (default 78; strict arm 84 to
# chase 95%+ published precision) and agreement floor (default 0.70).
# AI_PRECISION_GATE_CONF=78
# AI_PRECISION_GATE_AGREEMENT=0.70
# Auto-tighten on a 3-week precision breach streak (<75% each week):
# conf bar +5 per breach, cumulative cap +10, auto-reset at >=85%.
# off disables the mechanism (reporting continues in the weekly review).
# AI_PRECISION_GATE_AUTO_TIGHTEN=on

# ---- MCP mesh tuning ----
# Per-agent deadline in ms (default 8000) + hot-cache window in seconds
# (default 30; warm 5min / cold 60min are fixed tiers).
# AI_MCP_MESH_TIMEOUT_MS=8000
# AI_MCP_MESH_CACHE_HOT_SEC=30

# ---- MCP data agents (missing key = agent honestly ABSENT, never faked) ----
# Alpha Vantage — world stocks/forex/crypto quotes + fundamentals.
# Free tier 25/day; our budget 20/day.
# ALPHAVANTAGE_API_KEY=
# CoinGecko (official MCP vendor; demo key) — crypto prices, trending,
# market caps, on-chain context. Public endpoints also work keyless.
# COINGECKO_API_KEY=
# TradingCentral — real-time news sentiment + buzzing (paid; absent without key).
# TRADINGCENTRAL_API_KEY=
# Quiver Quantitative — US alt-data (Congress trades, insider activity).
# QUIVER_API_KEY=
# Massive — fundamentals + independent BS-Greeks/Sharpe quant checks.
# MASSIVE_API_KEY=
# CoinAPI — tick-level crypto trades (fallback role; 100/day free).
# COINAPI_API_KEY=
# Alpaca — US quotes (IEX feed) + market news (free paper-tier key pair).
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# (CCXT-style exchange mesh + TradingView + Finnhub ride the repo's own
#  proven keyless/fexisting feeds — zero extra keys.)

# ============================================================
# v11.3 — CoinDCX OFFICIAL WebSocket price layer (24x7 realtime)
# The spot socket (stream-spot.coindcx.com, currentPrices@spot@1s +
# priceStats@spot@60s) and the futures book channel
# (stream.coindcx.com, currentPrices@futures@rt) back the whole price
# chain when Cloudflare-fronted REST (api/public.coindcx.com) times
# out from datacenter IPs. '0' disables the spot socket entirely.
# AI_CX_SPOT_WS=1
